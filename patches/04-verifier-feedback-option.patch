+def _verifier_feedback_mode() -> str:
+    """HB_VERIFIER_FEEDBACK: what the agent learns about each interim verification.
+
+    "binary" (default, unset / true): stock rejection turn, pass/fail only.
+    "none"   (false / 0 / no / off): neutral continuation, outcome withheld.
+    "score": the rejection turn also states the verifier's reward (0..1).
+    The verifier runs and is recorded in interim_verifier.jsonl in every mode.
+    """
+    value = os.environ.get("HB_VERIFIER_FEEDBACK", "true").strip().lower()
+    if value in {"0", "false", "no", "off", "none"}:
+        return "none"
+    if value == "score":
+        return "score"
+    return "binary"
+
+
+def _verifier_score(result) -> float | None:
+    rewards = getattr(result, "rewards", None) if result is not None else None
+    value = (rewards or {}).get("reward")
+    try:
+        return None if value is None else float(value)
+    except (TypeError, ValueError):
+        return None
+
+
+def _score_note(score: float | None) -> str:
+    if score is None:
+        return "The verifier score is unavailable for this submission."
+    return (
+        f"Verifier score for this submission: {score:.3f} (1.000 = fully passing). "
+        "No other verifier details are available."
+    )
+
+
+def _format_score_rejection(*, phase: int, remaining_sec: int, score: float | None) -> str:
+    """Same-conversation rejection that discloses the verifier reward."""
+    return (
+        "Your submitted solution did not pass verification. "
+        f"{_score_note(score)} Continue working from the current terminal and "
+        "conversation state. Re-read the original requirements, inspect your "
+        "implementation, and run your own focused checks before submitting again. "
+        f"This is continuation {phase}; approximately {remaining_sec} seconds remain."
+    )
+
+
+def _rejection_turn(
+    *,
+    same_conversation: bool,
+    base_instruction: str,
+    phase: int,
+    remaining_sec: int,
+    result,
+    phase_feedback: str | None = None,
+) -> str:
+    """Continuation prompt after a failed (or timed-out) interim verification."""
+    mode = _verifier_feedback_mode()
+    if mode == "none":
+        if same_conversation:
+            return _format_neutral_continue(phase=phase, remaining_sec=remaining_sec)
+        return _format_neutral_continue_instruction(
+            base_instruction, phase=phase, remaining_sec=remaining_sec
+        )
+    if mode == "score":
+        score = _verifier_score(result)
+        if same_conversation:
+            return _format_score_rejection(
+                phase=phase, remaining_sec=remaining_sec, score=score
+            )
+        return _format_continue_instruction(
+            base_instruction, phase=phase, remaining_sec=remaining_sec,
+            feedback=_score_note(score),
+        )
+    if same_conversation:
+        return _format_same_conversation_rejection(phase=phase, remaining_sec=remaining_sec)
+    return _format_continue_instruction(
+        base_instruction, phase=phase, remaining_sec=remaining_sec,
+        feedback=phase_feedback if phase_feedback is not None else "",
+    )
+
+
+def _format_neutral_continue(*, phase: int, remaining_sec: int) -> str:
+    """Continuation turn that does not reveal whether the submission passed."""
+    return (
+        "Your submission has been recorded. The result of verification is not "
+        "disclosed during the trial, which continues until its time budget ends. "
+        "Continue working from the current terminal and conversation state: "
+        "re-read the original requirements, review and strengthen your "
+        "implementation, and run your own focused checks; submit again whenever "
+        f"you have improved the solution. This is continuation {phase}; "
+        f"approximately {remaining_sec} seconds remain."
+    )
+
+
+def _format_neutral_continue_instruction(
+    base_instruction: str, *, phase: int, remaining_sec: int
+) -> str:
+    """New-conversation (phase) variant of the neutral continuation."""
+    return (
+        f"{base_instruction.rstrip()}\n\n"
+        "---\n"
+        "## CONTINUE WORKING\n\n"
+        f"Your previous submission (phase {phase}) has been recorded; its verification "
+        "result is not disclosed. You still have approximately "
+        f"{remaining_sec} seconds remaining in this trial.\n\n"
+        "**Do not stop.** This trial only ends at timeout. Your shell session and "
+        "project files are unchanged — review the requirements, strengthen your "
+        "implementation and run your own checks before submitting again.\n"
+    )
+
+
