+            "status": "timeout" if result is None else "ok",
+            "reward": (rewards or {}).get("reward"),
+            "rewards": rewards,
+            "passed": _verifier_passed(result),
+        }
+        try:
+            path = self._trial_paths.trial_dir / "interim_verifier.jsonl"
+            with path.open("a") as f:
+                f.write(json.dumps(record) + "\n")
+        except OSError as e:
+            self._logger.warning("Failed to record interim verifier result: %s", e)
