# Copy to .env (setup.sh does this) and fill in. Never commit .env.
# scripts/run_job.sh loads it; the keys stay on the host (never inside a task container).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DAYTONA_API_KEY=
# Local model served by vLLM (configs made with --model hosted_vllm/<name>); the api_base in the
# config takes precedence over HOSTED_VLLM_API_BASE. vLLM ignores the key unless started with --api-key.
HOSTED_VLLM_API_BASE=
HOSTED_VLLM_API_KEY=EMPTY
